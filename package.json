{
  "name": "trouve-ton-artisan",
  "private": true,
  "version": "1.0.0",
  "description": "Plateforme de mise en relation avec les artisans de la région Auvergne-Rhône-Alpes",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n front,api,mail -c blue,green,magenta \"npm:client\" \"npm:server\" \"npm:maildev\"",
    "client": "vite",
    "server": "node --watch --env-file-if-exists=.env server/index.js",
    "maildev": "maildev --smtp 1025 --web 1080",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "nodemailer": "^10.0.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "maildev": "^2.2.1",
    "oxlint": "^1.81.0",
    "sass": "^1.104.1",
    "vite": "^8.3.0"
  },
  "overrides": {
    "maildev": {
      "nodemailer": "$nodemailer"
    }
  }
}
