# Copier ce fichier en « .env » puis adapter les valeurs.
# Le fichier .env n'est jamais versionné (voir .gitignore).

# Port de l'API locale (le front Vite redirige /api vers ce port)
API_PORT=3001

# Serveur SMTP : maildev en développement (interface web sur http://localhost:1080)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Expéditeur des e-mails
MAIL_FROM="Trouve ton artisan <no-reply@trouve-ton-artisan.fr>"

# Adresse qui reçoit les messages du formulaire de contact.
# Laisser vide pour envoyer directement à l'adresse de l'artisan (production uniquement).
CONTACT_RECIPIENT=artisans@trouve-ton-artisan.local
